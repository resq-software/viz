# Binary 3D assets — track via Git LFS so the main history stays small.
# Activate locally with `git lfs install` before cloning or before pulling a
# branch that adds assets under client/public/.
*.glb   filter=lfs diff=lfs merge=lfs -text
*.gltf  filter=lfs diff=lfs merge=lfs -text
*.ktx2  filter=lfs diff=lfs merge=lfs -text
*.hdr   filter=lfs diff=lfs merge=lfs -text
*.exr   filter=lfs diff=lfs merge=lfs -text

# Baked geospatial rasters. Scoped to the bake output roots on purpose: the repo
# already tracks 19 small rasters (favicons, terrain textures) that belong in the
# tree, and a blanket `*.png` rule would force migrating those for no benefit.
#
# A 2048x2048 16-bit elevation tile is ~4 MiB and every re-bake writes a NEW
# incompressible blob. Re-bakes are expected to be routine, so this has to be in
# place BEFORE the first one — history cannot be un-fattened afterwards.
assets/geo/**/*.png      filter=lfs diff=lfs merge=lfs -text
assets/geo/**/*.tif      filter=lfs diff=lfs merge=lfs -text
assets/geo/**/*.tiff     filter=lfs diff=lfs merge=lfs -text
assets/geo/**/*.webp     filter=lfs diff=lfs merge=lfs -text
assets/geo/**/*.hgt      filter=lfs diff=lfs merge=lfs -text
assets/geo/**/*.bil      filter=lfs diff=lfs merge=lfs -text
assets/geo/**/*.nc       filter=lfs diff=lfs merge=lfs -text
assets/geo/**/*.mbtiles  filter=lfs diff=lfs merge=lfs -text
assets/geo/**/*.pmtiles  filter=lfs diff=lfs merge=lfs -text
data/**/*.png            filter=lfs diff=lfs merge=lfs -text
data/**/*.tif            filter=lfs diff=lfs merge=lfs -text
data/**/*.tiff           filter=lfs diff=lfs merge=lfs -text

# Compiled gh-aw workflows. This line is written and re-asserted by
# `gh aw compile` — edits to it do not survive a recompile.
#
# On `merge=ours`: it is inert unless someone runs
# `git config merge.ours.driver true`, because git ships no built-in `ours`
# low-level driver. Do NOT configure that driver in this repo: with it enabled,
# a merge bringing in recompiled lock files (including refreshed action SHAs)
# would be silently discarded while reporting success.
#
# Correct way to resolve any conflict in these files: re-run `gh aw compile`
# and commit the regenerated output, never hand-merge.
.github/workflows/*.lock.yml linguist-generated=true