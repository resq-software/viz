# Anchor the rule to the repo root — the real lockfile lives at
# src/ResQ.Viz.Web/package-lock.json and must be tracked for `npm ci`
# in CI and Dependabot to work. An un-anchored `package-lock.json`
# ignore would mask both. A root-level one, if present, is the
# artefact of running `npm install` from the wrong CWD; keep ignoring.
/package-lock.json

# Vite build outputs (generated from client/)
src/ResQ.Viz.Web/wwwroot/

# npm
src/ResQ.Viz.Web/node_modules/
src/ResQ.Viz.Web/client/node_modules/

# bun. package-lock.json is the authoritative lockfile: CI installs with
# `npm ci --legacy-peer-deps`, and Dependabot's npm ecosystem only ever updates
# the npm one. A tracked bun.lock therefore goes stale on every dependency bump
# with nothing to catch it — it silently drifted through #145 and #146, and
# `bun install --frozen-lockfile` failed on main. Enforcing it in CI is not an
# option either: that would fail every Dependabot PR. Local `bun install` still
# works and regenerates this file; it just is not version-controlled.
src/ResQ.Viz.Web/bun.lock

# NuGet scratch/cache directories that can appear when restore/build tools run
NuGetScratch*/
dotnet-sdk-advertising-temp/

# Python
__pycache__/

# Playwright / browser automation logs
.playwright-mcp/

# Local Claude Code state (per-project settings, scheduled-task locks)
.claude/

# Security assessment deliverables (contain internal IPs, exploitation evidence)
deliverables/

# Generated outputs
outputs/

# Local docs (specs, plans — not committed)
docs/
